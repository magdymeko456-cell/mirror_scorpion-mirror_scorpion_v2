name: mirror_scorpion_v2
description: Mirror Scorpion - حيث تُصنع البدايات
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '^3.5.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_tts: ^4.2.2
  speech_to_text: ^7.0.0
  http: ^1.3.0
  provider: ^6.1.4
  shared_preferences: ^2.3.5
  sqflite: ^2.3.0
  path_provider: ^2.1.5
  intl: ^0.20.2
  permission_handler: ^11.3.1
  file_picker: ^8.1.4
  image_picker: ^1.1.2
  clipboard: ^0.1.3
  share_plus: ^10.1.4
  url_launcher: ^6.3.1
  vibration: ^3.1.3
  sensors_plus: ^6.1.1
  vector_math: ^2.1.4

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true  # v2
